index 0000000..c7699c9
--- /dev/null
+++ b/migrations/0002_add_rating.sql
@@ -0,0 +1,4 @@
+-- v1.1.0: оценка от 1 до 5, необязательная.
+-- NULL-колонка → обратно совместимо: код v1.0.0 о ней не знает и продолжает работать.
+ALTER TABLE messages ADD COLUMN IF NOT EXISTS rating SMALLINT
+    CHECK (rating BETWEEN 1 AND 5);
