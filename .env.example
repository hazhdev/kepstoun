# Скопируйте в .env и задайте свой пароль: cp .env.example .env
# .env в git НЕ коммитится (см. .gitignore)
POSTGRES_DB=guestbook
POSTGRES_USER=guestbook
POSTGRES_PASSWORD=change-me
# Порт базы на вашем компьютере (для pytest и подключения с хоста)
POSTGRES_PORT=5433

# Для прод-выката (compose.prod.yaml): ваш образ в ghcr.io (только маленькие буквы!)
IMAGE=ghcr.io/your-github-login/kapstoun
